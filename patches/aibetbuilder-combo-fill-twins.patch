 }
 
+const POLY_SIZE_EPS = 1e-4;
+
+function polySizeKey(n) {
+  const x = toNum(n);
+  if (x == null || !(x > 0)) return 0;
+  return Math.round(x / POLY_SIZE_EPS);
+}
+
+export function isPolyFillRow(fill) {
+  if (!fill) return false;
+  const id = String(fill.fill_id || "");
+  const src = String((fill.raw && fill.raw.source) || fill.source || "");
+  const ticker = String(fill.ticker || "");
+  return id.startsWith("poly-") || src.startsWith("poly-") || /^caoc-/i.test(ticker);
+}
+
+export function polyFillKeepRank(fill) {
+  const id = String((fill && fill.fill_id) || "");
+  const src = String((fill && fill.raw && fill.raw.source) || (fill && fill.source) || "");
+  if (id.startsWith("poly-act:") || src.startsWith("poly-activity")) return 3;
+  if (id.startsWith("poly-recon:") || src.startsWith("poly-recon")) return 2;
+  if (id.startsWith("poly-pos:") || src.startsWith("poly-position")) return 0;
+  return isPolyFillRow(fill) ? 1 : -1;
+}
+
+// Same lock + caoc + size from activity and reconcile is one economic fill.
+// Prefer the poly-act trade id (combo-worker cleanup does the same).
+export function dedupePolyFillsBySize(fills = []) {
+  const poly = [];
+  const rest = [];
+  (fills || []).forEach((f) => {
+    if (!f) return;
+    if (isPolyFillRow(f)) poly.push(f);
+    else rest.push(f);
+  });
+  const groups = new Map();
+  poly.forEach((f) => {
+    const key = `${f.parlay_id || ""}|${String(f.ticker || "").toLowerCase()}|${polySizeKey(f.count)}`;
+    if (!groups.has(key)) groups.set(key, []);
+    groups.get(key).push(f);
+  });
+  const kept = [];
+  groups.forEach((same) => {
+    let best = same[0];
+    let bestRank = polyFillKeepRank(best);
+    same.slice(1).forEach((row) => {
+      const r = polyFillKeepRank(row);
+      if (r > bestRank) {
+        best = row;
+        bestRank = r;
+      }
+    });
+    kept.push(best);
+  });
+  return [...rest, ...kept];
+}
+
+export function dedupeFillsForDesk(fills = []) {
+  return dedupePolyFillsBySize(dedupeFillsByOrder(fills));
+}
+
 export function sumAttributedFills(fills = []) {
   const byParlay = {};
   let unattributed = 0;
-  dedupeFillsByOrder(fills).forEach((f) => {
