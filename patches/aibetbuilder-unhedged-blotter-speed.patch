From 89622efdec913ad338428a0829c07910a1ed974f Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 4 Sep 2026 00:26:11 +0000
Subject: [PATCH] Speed up the Unhedged blotter: 90s visible-tab refresh and
 slimmer queries.

Stop the 20s auto-refresh, select blotter columns instead of *, prefer
filled_at (+ updated_at) for Today/24h/7d, and keep head counts on the
filtered filled set so millions of seen rows are never downloaded.
---
 src/UnhedgedTape.jsx     | 10 +++-
 src/unhedgedTape.js      | 98 ++++++++++++++++++++++++++--------------
 src/unhedgedTape.test.js | 31 +++++++++----
 3 files changed, 97 insertions(+), 42 deletions(-)

diff --git a/src/UnhedgedTape.jsx b/src/UnhedgedTape.jsx
index ecf8966..6ab27a3 100644
--- a/src/UnhedgedTape.jsx
+++ b/src/UnhedgedTape.jsx
@@ -6,6 +6,8 @@
 // Summary + tape are MLB and NFL moneylines only. Default date chip is Today.
 // Today / 24h / 7d stay one page. Month / All time page only after that chip
 // is selected. Tiles use head counts (same window + venue + beat-fill).
+// Auto-refresh is 90s and only while the tab is visible; manual Refresh is enough.
+// Suggested index: unhedged_rfqs (status, filled_at desc).
 // Legs cell is a per-leg Fair / Kalshi / Poly breakdown plus sport + event date.
 import React, { useCallback, useEffect, useMemo, useRef, useState } from "react";
 import { createClient } from "@supabase/supabase-js";
@@ -25,6 +27,7 @@ import {
   unhedgedDateRangeLabel,
   unhedgedDateRangePages,
   unhedgedRefreshLabel,
+  UNHEDGED_AUTO_REFRESH_MS,
   visibleUnhedgedRows,
 } from "./unhedgedTape";
 
@@ -382,7 +385,12 @@ export default function UnhedgedTape({ user }) {
   useEffect(() => { reloadCounts(); }, [reloadCounts]);
   useEffect(() => {
     if (!owner || missingTable || unhedgedDateRangePages(dateRange)) return undefined;
-    const t = setInterval(() => { reloadRows(); reloadCounts(); }, 20000);
+    const tick = () => {
+      if (typeof document !== "undefined" && document.visibilityState === "hidden") return;
+      reloadRows();
+      reloadCounts();
+    };
+    const t = setInterval(tick, UNHEDGED_AUTO_REFRESH_MS);
     return () => clearInterval(t);
   }, [reloadRows, reloadCounts, owner, missingTable, dateRange]);
 
