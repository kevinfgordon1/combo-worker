+export function unhedgedBlotterSelect(dateCols = UNHEDGED_DATE_OR_COLS, orderByUpdatedAt = true) {
+  const drop = new Set();
+  if (!orderByUpdatedAt && !(dateCols || []).includes("updated_at")) drop.add("updated_at");
+  if (!(dateCols || []).includes("filled_at")) drop.add("filled_at");
+  return UNHEDGED_BLOTTER_COL_LIST.filter((c) => !drop.has(c)).join(",");
+}
 export const UNHEDGED_STATUSES = ["seen", "started", "would_quote", "quoted", "filled"];
