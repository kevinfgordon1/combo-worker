\set n random(1, 1000000000)
\set r random(5, 200)
\set h random(1, 72)
select sniper_reserve(jsonb_build_object('rfq_id','t-'||:n||'-'||:client_id,'combo_key','tc-'||:n||'-'||:client_id,'games',jsonb_build_array('TG'||(:n%6)),'legs',jsonb_build_array('TL'||(:n%20)),'dry_run',false,'risk',:r,'release_at',(now()+interval '1 hour')::text,'settle_at',(now()+make_interval(hours=>:h))::text),
 jsonb_build_object('total',10000,'long_total',5000,'short_settle_hours',32,'game',1e9,'leg',1e9,'daily_risk',1e9,'daily_loss',1e9,'per_hour',1e9,'day_start',(now()-interval '12 hours')::text,'live',true));
