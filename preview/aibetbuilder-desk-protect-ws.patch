diff --git a/lib/desk-protect-sweep.js b/lib/desk-protect-sweep.js
index 07378c4..c59d6f6 100644
--- a/lib/desk-protect-sweep.js
+++ b/lib/desk-protect-sweep.js
@@ -1348,7 +1348,153 @@ function replacementFromPending(row, existing, clock) {
   }, num(existing.quantity != null ? existing.quantity : row.pending_contracts), clock);
 }
 
+function cloneBook(payload) {
+  const data = payload && (payload.marketData || payload);
+  if (!data || typeof data !== 'object') return null;
+  const offers = Array.isArray(data.offers) ? data.offers : (Array.isArray(data.asks) ? data.asks : []);
+  return {
+    marketData: {
+      ...data,
+      bids: (data.bids || []).map((level) => ({ ...level })),
+      offers: offers.map((level) => ({ ...level })),
+    },
+  };
+}
+
+// The triggering snapshot still contains our size. The re-rest prices off the
+// next level, which is what the REST sweep does after the cancel lands.
+function bookWithoutOurSize(payload, row) {
+  const copy = cloneBook(payload);
+  if (!copy) return null;
+  const yes = num(row && row.yes_price);
+  const qty = num(row && row.contracts);
+  if (!(yes > 0 && yes < 1) || !(qty > 0)) return copy;
+  const bookSide = row.outcome === 'short' ? (row.action === 'buy' ? 'sell' : 'buy') : row.action;
+  const key = bookSide === 'sell' ? 'offers' : 'bids';
+  const next = [];
+  for (const level of copy.marketData[key] || []) {
+    const px = amountOf(level && (level.px != null ? level.px : level.price));
+    const q = Number(level && (level.qty != null ? level.qty : level.quantity));
+    if (px != null && Math.abs(px - yes) <= 5e-5 && Number.isFinite(q)) {
+      const left = q - qty;
+      if (left > 1e-4) next.push({ ...level, qty: String(left) });
+      continue;
+    }
+    next.push(level);
+  }
+  copy.marketData[key] = next;
+  return copy;
+}
+
+function bookWithTradeTouch(payload, row, tradeYes) {
+  const base = bookWithoutOurSize(payload, row) || { marketData: { bids: [], offers: [] } };
+  const px = num(tradeYes);
+  if (!(px > 0 && px < 1)) return base;
+  const data = base.marketData;
+  const touch = { px: { value: px.toFixed(4), currency: 'USD' }, qty: '1' };
+  const bookSide = row.outcome === 'short' ? (row.action === 'buy' ? 'sell' : 'buy') : row.action;
+  if (bookSide === 'sell') {
+    data.offers = [touch];
+    const bids = (data.bids || []).filter((level) => {
+      const bid = amountOf(level && (level.px != null ? level.px : level.price));
+      return bid != null && bid < px - 1e-9;
+    });
+    data.bids = bids.length ? bids : [{ px: { value: Math.max(px - 0.02, 0.01).toFixed(4), currency: 'USD' }, qty: '1' }];
+  } else {
+    data.bids = [touch];
+    const offers = (data.offers || []).filter((level) => {
+      const ask = amountOf(level && (level.px != null ? level.px : level.price));
+      return ask != null && ask > px + 1e-9;
+    });
+    data.offers = offers.length ? offers : [{ px: { value: Math.min(px + 0.02, 0.99).toFixed(4), currency: 'USD' }, qty: '1' }];
+  }
+  return base;
+}
+
+const HANDOFF_DONE = new Set([
+  'replaced', 'capped', 'disarmed', 'filled', 'canceled', 'expired', 'unresolved', 'gone',
+  'partial_canceled', 'partial_expired',
+]);
+
+// Worker already cancelled. Continue with the same re-rest as the REST sweep:
+// claim, reconcile, $1,000 chain cap, create-unknown, one replacement.
+async function runProtectWsHandoff({
+  client, store, notify, tracks, audits, now = Date.now, orderId, trigger, book, tradeYes, latencyMs, canceled,
+} = {}) {
+  await loadMods();
+  if (!store || !store.configured) {
+    return { ok: false, status: 503, error: 'Bet Protect registry is not configured. Apply sql/desk_protect_rests.sql and set SUPABASE_SERVICE_KEY.' };
+  }
+  const id = String(orderId || '').trim();
+  if (!id) return { ok: false, status: 400, error: 'orderId required' };
+  let row = await store.get(id);
+  if (!row) return { ok: false, status: 404, error: 'Protect order is not in the registry.' };
+  if (String(row.market_slug || '').startsWith('novig:')) return { ok: true, skipped: 'novig', fired: 0, actions: [] };
+  if (HANDOFF_DONE.has(row.status)) return { ok: true, skipped: row.status, fired: 0, actions: [] };
+  const clock = typeof now === 'function' ? now() : Number(now);
+  const nowIso = iso(clock);
+  const kind = String(trigger || 'ws-through');
+  if (row.status === 'sweeping' && canceled === true && row.sweep_token) {
+    const moved = await store.update(id, {
+      status: 'pending_lineage',
+      sweep_token: null,
+      hold_from: null,
+      cooldown_until: null,
+    }, { token: row.sweep_token });
+    if (moved) row = moved;
+  }
+  if (row.status === 'pending_book') {
+    const readable = book && (book.marketData || book.bids || book.offers);
+    if (!readable || kind === 'ws-disconnect') {
+      await noteCheck(audits, checkSample(row, null, null, {
+        trigger: 'ws-disconnect',
+        action: 'cancelled',
+        latencyMs,
+        checkedAt: nowIso,
+      }));
+      return { ok: true, skipped: 'no-rereset-while-blind', fired: 0, actions: [{ result: 'cancelled', reason: 'ws-disconnect', orderId: id }] };
+    }
+    const moved = await store.update(id, { status: 'pending_lineage', cooldown_until: null });
+    if (!moved) return { ok: true, skipped: 'pending_book', fired: 0, actions: [] };
+    row = moved;
+  }
+  if (row.status !== 'pending_lineage' && row.status !== 'pending_rereset') {
+    return { ok: true, skipped: row.status, fired: 0, actions: [] };
+  }
+  const marketSlug = row.market_slug;
+  let market = { ok: false };
+  try {
+    if (client && client.getMarketBySlug) market = price.readMarketSides(await client.getMarketBySlug(marketSlug));
+  } catch (_) { market = { ok: false }; }
+  const markets = { [marketSlug]: market };
+  let live = new Map();
+  try {
+    if (client && client.listOpenOrders) live = orderIndex(await client.listOpenOrders(), markets);
+  } catch (_) { live = new Map(); }
+  let depth = kind === 'ws-trade' ? bookWithTradeTouch(book, row, tradeYes) : bookWithoutOurSize(book, row);
+  if (!depth && client && client.getMarketBook) {
+    try { depth = bookWithoutOurSize(await client.getMarketBook(marketSlug), row); } catch (_) { depth = null; }
+  }
+  const depths = { [marketSlug]: depth };
+  const tracked = new Set([id]);
+  if (row.replaced_by) tracked.add(row.replaced_by);
+  const outcome = row.status === 'pending_rereset'
+    ? await finishRereset({ client, store, notify, row, live, markets, tracked, clock, nowIso, tracks })
+    : await resumeLineageReplace({ client, store, notify, row, live, markets, depths, tracked, clock, nowIso, tracks });
+  const action = outcome && outcome.action;
+  await noteCheck(audits, checkSample(row, null, depth && readProtectBook(depth, clock, nowIso), {
+    trigger: kind,
+    action: (action && action.result) || 'none',
+    replacementId: action && action.newOrderId,
+    latencyMs,
+    checkedAt: nowIso,
+  }));
+  return { ok: true, fired: outcome && outcome.fired ? 1 : 0, actions: action ? [action] : [] };
+}
+
 module.exports = {
   runProtectSweep,
+  runProtectWsHandoff,
   findAdopt,
+  bookWithoutOurSize,
 };
